---
interface Props {
  title: string;
  description: string;
  date: Date;
  url: string;
  tags?: string[];
}

const { title, description, date, url, tags } = Astro.props;
---

<article>
  <div class="meta">
    <time datetime={date.toISOString()}>
      {
        new Intl.DateTimeFormat("en-US", {
          year: "numeric",
          month: "short",
          day: "numeric",
        }).format(date)
      }
    </time>
    {
      tags && (
        <ul class="tags" role="list">
          {tags.map((tag) => (
            <li><a href={`/tag/${tag}/`}>#{tag}</a></li>
          ))}
        </ul>
      )
    }
  </div>
  <h2>
    <a href={url}>{title}</a>
  </h2>
  <p>{description}</p>
</article>

<style lang="scss">
  article {
    padding-block: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--color-fg-tertiary);
    margin-bottom: 0.25rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;

    a {
      color: inherit;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
    }
  }

  h2 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-block: 0.2rem 0.4rem;

    a {
      color: var(--color-fg-primary);
      text-decoration: none;

      &:hover {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
      }
    }
  }

  p {
    margin-block: 0;
    font-size: 0.9rem;
    color: var(--color-fg-tertiary);
    line-height: 1.5;
  }
</style>
