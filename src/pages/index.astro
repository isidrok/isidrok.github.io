---
import Layout from "@layout/layout.astro";
import { getCollection } from "astro:content";
import PostList from "@components/post-list.astro";

const PAGE_SIZE = 5;
const SHOWN_TAGS = ["agents", "backend", "web", "ai", "dev"];

const posts = await getCollection("blog");
const allPosts = posts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const page = {
  data: allPosts.slice(0, PAGE_SIZE),
  currentPage: 1,
  lastPage: Math.ceil(allPosts.length / PAGE_SIZE),
  url: { prev: undefined, next: allPosts.length > PAGE_SIZE ? "/posts/2/" : undefined },
};
---

<Layout
  title="~/isidrok"
  description="Isidro's personal blog about web development, software engineering, and technology"
  type="website"
  canonicalURL={Astro.url.href}
>
  <div class="home">
    <header class="intro">
      <h1>Isidro Torregrosa</h1>
      <p>
        Software Engineer focused on TypeScript, Node.js, Web Development and AI.
      </p>
    </header>
    <PostList page={page} allTags={SHOWN_TAGS} />
  </div>
</Layout>

<style lang="scss">
  .home {
    padding-top: 3rem;
  }

  .intro {
    margin-bottom: 2rem;

    h1 {
      font-size: 1.75rem;
      margin-bottom: 0.4rem;
    }

    p {
      margin-block: 0;
      font-size: 1rem;
      color: var(--color-fg-tertiary);
    }
  }
</style>
