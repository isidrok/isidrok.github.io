---
import Layout from "@layout/layout.astro";
import { getCollection } from "astro:content";
import PostList from "@components/post-list.astro";

const SHOWN_TAGS = ["agents", "backend", "web", "ai", "dev"];
const PAGE_SIZE = 5;

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const shownTags = ["agents", "backend", "web", "ai", "dev"];
  const posts = await getCollection("blog");
  const allPosts = posts
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  return shownTags.flatMap((tag) => {
    const tagPosts = allPosts.filter((p) => p.data.tags?.includes(tag as any));
    return paginate(tagPosts, { params: { tag }, pageSize: 5 });
  });
}

const { page } = Astro.props;
const { tag } = Astro.params;
---

<Layout
  title={`#${tag} · ~/isidrok`}
  description={`Posts tagged #${tag} on Isidro's blog`}
  type="website"
  canonicalURL={Astro.url.href}
>
  <div class="home">
    <header class="intro">
      <h1>Isidro Torregrosa</h1>
      <p>
        Software Engineer focused on TypeScript, Node.js, Web Development and AI.
      </p>
    </header>
    <PostList page={page} allTags={SHOWN_TAGS} activeTag={tag} />
  </div>
</Layout>

<style lang="scss">
  .home {
    padding-top: 3rem;
  }

  .intro {
    margin-bottom: 2rem;

    h1 {
      font-size: 1.75rem;
      margin-bottom: 0.4rem;
    }

    p {
      margin-block: 0;
      font-size: 1rem;
      color: var(--color-fg-tertiary);
    }
  }
</style>
