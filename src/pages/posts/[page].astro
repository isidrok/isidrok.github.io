---
import Layout from "@layout/layout.astro";
import { getCollection } from "astro:content";
import PostList from "@components/post-list.astro";

const SHOWN_TAGS = ["ai", "node.js", "web", "dev"];
const PAGE_SIZE = 5;

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const pageSize = 5;
  const posts = await getCollection("blog");
  const allPosts = posts
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  // page 1 is handled by index.astro, start from page 2
  return paginate(allPosts, { pageSize }).slice(1);
}

const { page } = Astro.props;
---

<Layout
  title={`Posts — page ${page.currentPage} · ~/isidrok`}
  description="Isidro's personal blog about web development, software engineering, and technology"
  type="website"
  canonicalURL={Astro.url.href}
>
  <div class="home">
    <header class="intro">
      <h1>Isidro Torregrosa</h1>
      <p>
        Software Engineer focused on TypeScript, Node.js, Web Development and AI.
      </p>
    </header>
    <PostList page={page} allTags={SHOWN_TAGS} />
  </div>
</Layout>

<style lang="scss">
  .home {
    padding-top: 3rem;
  }

  .intro {
    margin-bottom: 2rem;

    h1 {
      font-size: 1.75rem;
      margin-bottom: 0.4rem;
    }

    p {
      margin-block: 0;
      font-size: 1rem;
      color: var(--color-fg-tertiary);
    }
  }
</style>
